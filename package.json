{
  "name": "aws-setup",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "bootstrap": "source .env && cdk bootstrap aws://$ACCOUNT_ID/eu-west-1 && cdk bootstrap aws://$ACCOUNT_ID/us-east-1",
    "build": "tsc",
    "ci": "pnpm run '/^(build|lint|test)$/'",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1047.0",
    "@aws-sdk/client-identitystore": "^3.1047.0",
    "@aws-sdk/client-sns": "^3.1047.0",
    "@aws-sdk/client-sso-admin": "^3.1047.0",
    "aws-cdk-lib": "^2.254.0"
  },
  "devDependencies": {
    "@ml/eslint-config": "github:mellevanderlinde/eslint-config#v1.8.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.8.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.6.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
